# Variables de entorno para producción
# Estas se usarán cuando NODE_ENV=production

# URL de la API de backend (configurar en Netlify)
VITE_API_URL=https://tu-backend.onrender.com

# Configuración de Stripe (producción)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_tu_clave_publica_stripe

# Configuración de la aplicación
VITE_APP_NAME=Antigravity Repuestos
VITE_APP_VERSION=1.0.0

# Para debugging en producción
VITE_LOG_LEVEL=warn